<div class="flex flex-col">
  <h1 class="pb-8 font-sans text-xl">Mes decks</h1>
  <div class="grid grid-cols-2 gap-4">
    <% @decks.each do |deck| %>
      <%= link_to deck_review_path(deck), class: "bg-white rounded-xl shadow-md p-6 hover:shadow-lg transition-shadow flex flex-col justify-between gap-2 hover:ring-2 hover:ring-blue-500" do %>
        <p class="mr-4 text-blue-600">
          <%= deck.name %>
        </p>
        <div class="text-indigo-300 text-sm font-mono">
          <%= deck.cards.count%> cartes
        </div>
      <% end %>
    <% end %>
  </div>
</div>
