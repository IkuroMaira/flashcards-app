<div class="flex flex-col items-center w-full h-full justify-between bg-gray-50">
  <div class="flex justify-between w-full max-w-4xl p-2 text-xs">
    <h1 class="p-2">
    Review <%= @deck.name %>
    </h1>

    <p class="flex text-indigo-300 p-2">
      <%= @position + 1 %> / <%= @cards.count %>
    </p>
  </div>

  <div class="flex-col w-full h-full max-w-4xl flex items-center justify-center p-4">
    <turbo-frame id="card-content" class="flex flex-col bg-white rounded-xl shadow-2xl p-6 w-full h-full">
      <h3 class="text-blue-600 p-2">
        <%= @card.question %>
      </h3>

      <% if @answer %>
        <p class="rounded-xl bg-indigo-100 text-blue-600 p-4 font-sans">
          <%= @answer %>
        </p>
      <% else %>
        <%= link_to 'Voir la réponse', deck_review_path(@deck, position: @position, reveal: true), class: "mt-auto text-center rounded-xl bg-blue-600 text-white font-sans p-3" %>
      <% end %>
    </turbo-frame>

    <div class="flex justify-between w-full max-w-4xl p-6">
      <%= link_to 'Précédent', deck_review_path(@deck, position: @position - 1) %>
      <%= link_to 'Suivant', deck_review_path(@deck, position: @position + 1) %>
    </div>
  </div>
</div>
