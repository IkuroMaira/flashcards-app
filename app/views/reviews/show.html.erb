<h1>Review <%= @deck.name %></h1>
<p>Position : <%= @position + 1 %> / <%= @cards.count -1 %></p>

<turbo-frame id="card-content">
  <% if @answer %>
    <%= @answer %>
  <% else %>
    <h3>
      <%= @card.question %>
    </h3>
    <%= link_to 'Voir la réponse', deck_review_path(@deck, position: @position, reveal: true) %>
  <% end %>
</turbo-frame>

<%= link_to 'Précédent', deck_review_path(@deck, position: @position - 1) %>
<%= link_to 'Suivant', deck_review_path(@deck, position: @position + 1) %>
